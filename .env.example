# Modelo de variáveis de ambiente.
# Copie este arquivo para ".env" e preencha os valores. O ".env" NUNCA vai para o Git.

# URL base da API (já inclui o prefixo /api/v1)
API_BASE_URL=https://api-dedetiza.gladiai.com/api/v1

# Documento OpenAPI (Swagger) em JSON — usado pelo relatório de cobertura
OPENAPI_URL=https://api-dedetiza.gladiai.com/docs-json

# Tenant (empresa) em que os testes rodam — exigido pelo POST /auth/login
TENANT_ID=

# Usuário admin (todas as permissões)
ADMIN_EMAIL=admin@dedetiza.com
ADMIN_PASSWORD=
